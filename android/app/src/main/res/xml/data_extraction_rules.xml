<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep login tokens and the offline database off backups/transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="matrix_market.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="matrix_market.db" />
    </device-transfer>
</data-extraction-rules>
